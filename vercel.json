{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "redirects": [
    {
      "source": "/vedantasp/blogs",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/vedantasp/blogs/:path*",
      "destination": "/blogs/:path*",
      "permanent": true
    }
  ]
}
